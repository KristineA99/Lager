@model Product

<h1>Nytt produkt</h1>

@* asp-action="Create" sender skjemaet til [HttpPost] Create i controlleren *@
<form asp-action="Create" method="post" class="col-md-6">

    @* Viser feil som gjelder hele skjemaet *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* asp-for kobler feltet til en egenskap i Product.
       Teksten i label kommer fra [Display(Name = "...")] i modellen. *@
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        @* Lager en nedtrekksliste fra enumen ProductType *@
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ProductType>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="VolumeMl" class="form-label"></label>
        <input asp-for="VolumeMl" class="form-control" />
        <span asp-validation-for="VolumeMl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="row">
        <div class="col mb-3">
            <label asp-for="QuantityInStock" class="form-label"></label>
            <input asp-for="QuantityInStock" class="form-control" />
            <span asp-validation-for="QuantityInStock" class="text-danger"></span>
        </div>
        <div class="col mb-3">
            <label asp-for="MinimumStock" class="form-label"></label>
            <input asp-for="MinimumStock" class="form-control" />
            <span asp-validation-for="MinimumStock" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Lagre</button>
    <a class="btn btn-link" asp-action="Table">Avbryt</a>
</form>